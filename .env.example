# Runtime paths
WORKFOLDER=./workfolder
MODEL_CACHE_DIR=./data/modelscope
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=

# Device: cuda, cuda:0, cpu, or auto
DEVICE=cuda

# Optional explicit media binary paths when they are not on PATH.
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe

# Maximum local video upload size in bytes. Default: 4 GiB.
LOCAL_UPLOAD_MAX_BYTES=4294967296

# OpenAI-compatible translator
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# FunASR
FUNASR_MODEL=iic/SenseVoiceSmall
FUNASR_VAD_MODEL=fsmn-vad

# IndexTTS (download checkpoints first; see https://github.com/index-tts/index-tts)
INDEXTTS_MODEL_DIR=./checkpoints
INDEXTTS_CFG_PATH=
# Optional auto-download (set both source + model id)
# INDEXTTS_MODEL_SOURCE=modelscope
# INDEXTTS_MODEL_ID=IndexTeam/IndexTTS-2
INDEXTTS_AUTO_DOWNLOAD=true
INDEXTTS_USE_FP16=false
INDEXTTS_USE_CUDA_KERNEL=false
INDEXTTS_USE_DEEPSPEED=false
INDEXTTS_MIN_REFERENCE_MS=1200
# Optional emotion control
# INDEXTTS_EMO_AUDIO_PROMPT=
# INDEXTTS_EMO_ALPHA=
# INDEXTTS_USE_EMO_TEXT=false
# INDEXTTS_EMO_TEXT=

# Optional proxy for yt-dlp
HTTP_PROXY=
