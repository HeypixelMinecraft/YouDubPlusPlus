# Copy values into .env for application runtime.
# Keep env.txt for local editing if you do not want to open .env directly.
WORKFOLDER=./workfolder
MODEL_CACHE_DIR=./data/modelscope
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=
YOUDUB_MCP_ENABLED=true
YOUDUB_MCP_HOST=127.0.0.1
YOUDUB_MCP_PORT=8765
DEVICE=cuda
FFMPEG_PATH=
FFPROBE_PATH=
LOCAL_UPLOAD_MAX_BYTES=4294967296
TRANSLATE_MODE=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSLATE_CONCURRENCY=50
YTDLP_PROXY_PORT=
FUNASR_MODEL=iic/SenseVoiceSmall
FUNASR_VAD_MODEL=fsmn-vad
VOXCPM_MODEL=OpenBMB/VoxCPM2
VOXCPM_MODEL_DIR=
VOXCPM_LOAD_DENOISER=false
VOXCPM_CFG_VALUE=2.0
VOXCPM_INFERENCE_TIMESTEPS=10
VOXCPM_MIN_REFERENCE_MS=1200
HTTP_PROXY=
