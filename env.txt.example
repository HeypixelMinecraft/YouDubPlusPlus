# Copy values into .env for application runtime.
# Keep env.txt for local editing if you do not want to open .env directly.
WORKFOLDER=./workfolder
MODEL_CACHE_DIR=./data/modelscope
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=
DEVICE=cuda
FFMPEG_PATH=
FFPROBE_PATH=
LOCAL_UPLOAD_MAX_BYTES=4294967296
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSLATE_CONCURRENCY=50
YTDLP_PROXY_PORT=
FUNASR_MODEL=iic/SenseVoiceSmall
FUNASR_VAD_MODEL=fsmn-vad
INDEXTTS_MODEL_DIR=./checkpoints
INDEXTTS_CFG_PATH=
INDEXTTS_MODEL_SOURCE=
INDEXTTS_MODEL_ID=
INDEXTTS_AUTO_DOWNLOAD=true
INDEXTTS_USE_FP16=false
INDEXTTS_USE_CUDA_KERNEL=false
INDEXTTS_USE_DEEPSPEED=false
INDEXTTS_MIN_REFERENCE_MS=1200
INDEXTTS_EMO_AUDIO_PROMPT=
INDEXTTS_EMO_ALPHA=
INDEXTTS_USE_EMO_TEXT=false
INDEXTTS_EMO_TEXT=
HTTP_PROXY=
